# Written by ts-rs from the Rust wire types (src-tauri/tests/wire_types.rs byte-compares them).
# LF everywhere, or a Windows checkout with autocrlf fails that comparison.
src/store/generated/** linguist-generated=true eol=lf

# EA's career-mode structure files, byte for byte as the game ships them (CRLF, one with a
# byte-order mark). The importer reads either line ending; this keeps a checkout from rewriting them.
tools/eafc-import/data/fc27-compdata/** -text
